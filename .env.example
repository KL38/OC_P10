# --- Mistral API (REQUIRED) ---
# Get a key at https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# --- PostgreSQL / Supabase (optional in Phase 0/1, REQUIRED from Phase 3) ---
# Admin/write role — used ONLY by scripts/load_excel_to_db.py.
# Session pooler example: postgresql://postgres.<project-ref>:pass@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# SELECT-only role used by the app at runtime (SqlTool). Falls back to
# DATABASE_URL if empty (local dev) — set it in any real deployment.
# Example: postgresql://sportsee_reader.<project-ref>:pass@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL_READONLY=

# --- Pydantic Logfire (optional) ---
# Without a token, Logfire runs locally (no data sent to the cloud).
LOGFIRE_TOKEN=
