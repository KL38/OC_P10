# --- Mistral API (REQUIRED) ---
# Get a key at https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# --- PostgreSQL / Supabase (optional in Phase 0/1, REQUIRED from Phase 3) ---
# Supabase pooler example: postgresql://user:pass@host:6543/postgres
DATABASE_URL=

# --- Pydantic Logfire (optional) ---
# Without a token, Logfire runs locally (no data sent to the cloud).
LOGFIRE_TOKEN=
